APP_NAME=CalcuPost
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://calcupost.example.com
# IP addresses/CIDRs of the HTTPS reverse proxy, comma-separated. Empty trusts none.
TRUSTED_PROXIES=

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
# Configure the database host reachable from inside the container.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=calcupost
DB_USERNAME=
DB_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
